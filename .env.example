# Discord Developer Portal > Bot > Token
TOKEN=replace_with_your_bot_token

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=replace_with_your_application_id

# Optional: test guild ID for immediate command updates. Leave blank for global commands.
GUILD_ID=

# Optional Discord channel and role IDs
WELCOME_CHANNEL_ID=
STAFF_ROLE_ID=
TICKET_CATEGORY_ID=
TICKET_LOG_CHANNEL_ID=
COMMUNITY_TAG_ROLE_ID=
COMMUNITY_TAG=COMMUNITY

# Public server details used by /ip and /durum
SERVER_NAME=Community Server
BOT_NAME=Community Bot
DEFAULT_IP=play.example.com
MINECRAFT_SERVER_ADDRESS=play.example.com
MINECRAFT_SERVER_PORT=25565
BEDROCK_PORT=19132
DEFAULT_VERSION=Java 1.20.x - 1.21.x
DEFAULT_TYPE=Minecraft
WEBSITE_URL=https://example.com
VOTE_URL=https://example.com/vote

# Optional appearance
PREFIX=!
EMBED_COLOR=#3B82F6
